# Copy to .env (development) or /etc/velox/api.env (servers). Never commit real values.
VELOX_APP_MODE=development            # development | sandbox | production
VELOX_PUBLIC_WEB_URL=http://localhost:4200
VELOX_DATABASE_URL=postgresql+psycopg://velox:velox@localhost:5432/velox

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VELOX_JWT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VELOX_ENCRYPTION_KEY=
VELOX_COOKIE_SECURE=false             # true everywhere except local http development
VELOX_CORS_ORIGINS=["http://localhost:4200"]
VELOX_PASSWORD_BREACH_CHECK=false     # true in sandbox/production
VELOX_REQUIRE_STAFF_MFA=true

VELOX_SHIPPING_PROVIDER=mock          # mock | easypost (Phase 2)
VELOX_EMAIL_PROVIDER=console          # console | postmark
VELOX_EMAIL_FROM=Velox <no-reply@localhost>
VELOX_POSTMARK_SERVER_TOKEN=
