# Copy to backend/.env (development) or /etc/velox/api.env (servers: chmod 640, group velox).
# Never commit real values. Comments must be on their own line (systemd does not allow inline comments).

# development | sandbox | production
VELOX_APP_MODE="development"
VELOX_PUBLIC_WEB_URL="http://localhost:4200"
VELOX_DATABASE_URL="postgresql+psycopg://velox:velox@localhost:5432/velox"

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VELOX_JWT_SECRET=""
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VELOX_ENCRYPTION_KEY=""
# true everywhere except local http development
VELOX_COOKIE_SECURE="false"
VELOX_CORS_ORIGINS='["http://localhost:4200"]'
# true in sandbox and production
VELOX_PASSWORD_BREACH_CHECK="false"
VELOX_REQUIRE_STAFF_MFA="true"

# mock | easypost (Phase 2)
VELOX_SHIPPING_PROVIDER="mock"
# console | postmark
VELOX_EMAIL_PROVIDER="console"
VELOX_EMAIL_FROM="Velox <no-reply@localhost>"
VELOX_POSTMARK_SERVER_TOKEN=""
